{
  "name": "superformdata",
  "version": "0.2.0",
  "description": "Serialize rich JavaScript values into form-style entries and decode them back again",
  "homepage": "https://github.com/samlaycock/superformdata#readme",
  "bugs": {
    "url": "https://github.com/samlaycock/superformdata/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samlaycock/superformdata.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.mts"
      ],
      "client": [
        "dist/client.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    }
  },
  "scripts": {
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --type-aware --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "test": "bun test",
    "bench": "bun scripts/bench.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "smoke:package": "bun scripts/package-smoke.ts",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test && bun run build && bun run smoke:package",
    "prepublishOnly": "bun run check",
    "ci:publish": "bun run check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@happy-dom/global-registrator": "20.9.0",
    "@types/bun": "1.3.13",
    "happy-dom": "20.9.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "tsdown": "0.21.10",
    "typescript": "^5"
  }
}
